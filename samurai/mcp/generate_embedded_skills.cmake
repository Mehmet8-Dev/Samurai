# Generates embedded_skills.hpp from skills/samurai-*/SKILL.md at build time.
# Uses HEX encoding so arbitrary UTF-8, quotes, and newlines embed safely in C++17.

if(NOT DEFINED SKILLS_ROOT OR NOT DEFINED OUTPUT_HPP)
  message(FATAL_ERROR "SKILLS_ROOT and OUTPUT_HPP must be defined")
endif()

set(_slugs
  "samurai-netbench"
  "samurai-cluster-orchestrator"
  "samurai-autopilot-rl"
  "samurai-scenario-author"
  "samurai-hardware-dataplane"
)

set(_out "#pragma once\n\n")
string(APPEND _out "// Auto-generated by generate_embedded_skills.cmake. Do not edit manually.\n\n")
string(APPEND _out "#include <cstddef>\n#include <string>\n\nnamespace samurai::mcp {\n\n")

set(_lookup_cases "")

foreach(_slug IN LISTS _slugs)
  set(_md_path "${SKILLS_ROOT}/${_slug}/SKILL.md")
  if(NOT EXISTS "${_md_path}")
    message(FATAL_ERROR "Skill markdown not found: ${_md_path}")
  endif()
  string(REPLACE "-" "_" _ident "${_slug}")
  file(READ "${_md_path}" _hex HEX)
  string(LENGTH "${_hex}" _hex_len)
  math(EXPR _byte_len "${_hex_len} / 2")

  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
  string(APPEND _out "inline constexpr unsigned char kEmbeddedSkill_${_ident}[] = {${_bytes}0x00};\n")
  string(APPEND _out "inline constexpr std::size_t kEmbeddedSkillLen_${_ident} = ${_byte_len};\n\n")

  string(APPEND _lookup_cases
    "  if (slug == \"${_slug}\") {\n"
    "    return std::string(reinterpret_cast<const char*>(kEmbeddedSkill_${_ident}), kEmbeddedSkillLen_${_ident});\n"
    "  }\n")
endforeach()

string(APPEND _out "inline std::string EmbeddedSkillMarkdown(const std::string& slug) {\n")
string(APPEND _out "${_lookup_cases}")
string(APPEND _out "  return {};\n}\n\n}  // namespace samurai::mcp\n")

file(WRITE "${OUTPUT_HPP}.tmp" "${_out}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT_HPP}.tmp" "${OUTPUT_HPP}")
file(REMOVE "${OUTPUT_HPP}.tmp")
