{
  "id": null,
  "uid": "samurai-distributed-controlplane",
  "title": "Samurai Distributed Control Plane",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "tags": ["samurai", "distributed", "control-plane"],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "region",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(samurai_distributed_region_sent, region)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Workers Live",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "samurai_distributed_workers_live", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "HA Leader Epoch",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "max(samurai_distributed_ha_leader_epoch)", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "KPI Gate Status",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "samurai_distributed_kpi_gate_status", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Per-Shard KPI Failed",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "samurai_distributed_per_shard_kpi_failed_count", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries",
      "title": "Sent / Errors",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        { "expr": "samurai_distributed_sent", "legendFormat": "sent", "refId": "A" },
        { "expr": "samurai_distributed_errors", "legendFormat": "errors", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Region Sent",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "samurai_distributed_region_sent{region=~\"$region\"}",
          "legendFormat": "{{region}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Region Errors",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "samurai_distributed_region_errors{region=~\"$region\"}",
          "legendFormat": "{{region}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Workers by Region",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "expr": "sum by(region) (samurai_distributed_worker_region{region=~\"$region\"})",
          "legendFormat": "{{region}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Multi-Master Enabled",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 21 },
      "targets": [{ "expr": "samurai_distributed_multi_master_enabled", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Multi-Master Regions Live",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 21 },
      "targets": [{ "expr": "samurai_distributed_multi_master_regions_live", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    }
  ]
}
